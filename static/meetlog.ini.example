[database]
host = localhost
port = 3306
name = meetlog
user = meetlog
pass = meetlog
charset = utf8mb4

[mail]
server = smtpserver
port = 587
usessl = false
user = mail@example.com
pass = "Password"
from = mail@example.com

[update]
; Clone-URL des GitHub-Repositorys für die Update-Prüfung (leer = deaktiviert)
repo_url = "https://github.com/axellenceit/MeetLog"
; Optional: Zugangsdaten für private Repositories (GitHub-Benutzer + Personal Access Token)
user = ""
pass = ""
; Cache-Lebensdauer in Sekunden
cache_ttl = 3600